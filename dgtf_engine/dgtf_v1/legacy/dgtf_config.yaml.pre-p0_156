# ============================================================
# 元 DGTF · v1.21.55 配置文件
# ============================================================
# 【本文件是 DEFAULT_CONFIG 的覆盖层】
#   缺省字段用代码内置默认，不需要全部写出。
#
# 【参数优先级（高 → 低）】
#   ① 命令行参数（CLI）
#   ② 交互模式询问（无 CLI 参数时）
#   ③ 本 YAML 配置文件
#   ④ 代码 DEFAULT_CONFIG
#
# 【环境变量优先级（高于 api 段）】
#   DGTF_API_KEY        > OPENAI_API_KEY    > api.key
#   DGTF_BASE_URL       > api.base_url
#   DGTF_MODEL          > api.default_model
#   DGTF_REASONER_MODEL > api.reasoner_model
#
# 【分层说明】
#   api      —— API 连接
#   output   —— 展示开关（只影响日志/终端显示）
#   actions  —— 逻辑开关（决定"做不做某一步"）
#   probe    —— 探针筛选参数
#   memory   —— 三通道记忆参数
#   spiral   —— 螺旋停止 / 循环判据
#
# 【修改心法】
#   调"要不要做某事"   → 改 actions
#   调"要不要打印某事" → 改 output
#   调"跑多久 / 多严"  → 改 spiral
#   调"用哪个并行模式" → 改 actions.parallel_mode
#                        （serial/A/B/C/D/E/F/G/H/auto，auto 现在九选一）
#   调"B/C 预热几圈"   → 改 actions.parallel_warmup_rounds
#
# ⚠️ 【曾经的坑 · v1.21.51 [fix-105] 已修】
#   --parallel 的 argparse default 原来是硬编码 "auto"，
#   不传也会覆盖本文件的 parallel_mode。现在 default=None，
#   不传 → 回落本文件；显式传 → 覆盖本文件。两条都对。
# ============================================================


# ------------------------------------------------------------
# API 连接
# ------------------------------------------------------------
api:
  # 【建议】留空，用环境变量。
  #   避免 API Key 进版本库。
  #   设置方法：export DGTF_API_KEY="sk-xxx"
  #           或写 .env 文件（代码会自动 load_dotenv）
  #
  # 【优先级】DGTF_API_KEY > OPENAI_API_KEY > 本字段
  key: ""

  # 【建议】保持默认 DeepSeek。
  #   换其他端点需测试兼容性（尤其是 response_format: json_object）。
  # 【环境变量】DGTF_BASE_URL 覆盖本字段
  # 【可选值】
  #   https://api.deepseek.com/v1      （DeepSeek，默认）
  #   https://api.openai.com/v1        （OpenAI）
  #   https://api.moonshot.cn/v1       （Moonshot）
  base_url: "https://api.deepseek.com/v1"

  # 【用途】大部分 LLM 调用（展开 / 对偶判断 / & 沉淀 / 探针 / self-check）
  # 【环境变量】DGTF_MODEL 覆盖本字段
  default_model: "deepseek-chat"

  # 【用途】需要长链推理的两处：ing 对撞 / view 显形
  # 【环境变量】DGTF_REASONER_MODEL 覆盖本字段
  # 【识别判据】_is_reasoner() 检查名字里是否含：
  #   "reasoner" / "-r1" / "reasoning"
  #   → 换非 DeepSeek 推理模型（如 "o1"）可能识别不到，
  #     需要改 LLM._is_reasoner 的判据。
  # 【降级】若 reasoner 调用失败，会自动降级到 default_model 重试。
  reasoner_model: "deepseek-reasoner"

  # 【建议】≥ 180。
  #   reasoner 输出长，单次可能 60-120 秒。
  #   太小会导致频繁超时重试，反而更慢。
  timeout: 240

  # 【建议】
  #   网络稳定：3
  #   网络不稳：5
  # 【注意】太大拖慢失败感知；每次重试等待 backoff^n 秒。
  max_retries: 3

  # 【建议】1.8
  #   第 n 次重试等待 backoff^n 秒。
  #   1.8 → 1.8 / 3.24 / 5.83 秒。
  # 【注意】别小于 1.5，否则可能被 API 限流。
  retry_backoff: 1.8


# ------------------------------------------------------------
# 展示开关（只影响日志 / 终端显示，不影响逻辑）
# ------------------------------------------------------------
output:
  # 【用途】结果保存目录。相对当前工作目录。
  # 【产物】outputs/YYYYMMDD_HHMMSS_<问题前20字>.md
  #         outputs/diagnostic_position_*.log（position_all_same 时）
  save_dir: "outputs"

  # 【建议】
  #   开发调试：true（详细日志，好定位）
  #   批量生产：false（只打印 view 显形和最终摘要）
  # 【影响】false = 安静模式
  verbose: true

  # 【用途】是否打印对偶判断的每条候选细节。
  # 【建议】
  #   调对偶判断时：true
  #   日常：false（可减 80% 输出）
  show_dual_judge: true

  # 【用途】是否在终端完整打印 ing 输出全文。
  # 【注意】ing 通常 1000-2000 字，全开会淹没终端。
  # 【建议】
  #   默认：false
  #   调试对撞质量：临时开
  # 【CLI 覆盖】--show-ing
  show_ing: false

  # 【用途】是否在终端完整打印 view 显形全文。
  # 【注意】view 通常 800-2000 字，全开会淹没终端。
  # 【建议】
  #   默认：false
  #   想直接读终端：临时开
  # 【CLI 覆盖】--show-view
  show_manifest: false

  # 【用途】对偶判断后回看一遍（LLM 自省）。
  # 【建议】
  #   质量优先：true
  #   速度优先：false（每圈省 1 次 LLM 调用）
  # 【⚠️ 重要】关闭后 streak 机制失效：
  #   _rephrased_streak / meta_idle_streak 不累积，
  #   fix-72 v3（对撞/元层 ing 复述直接判 idle）不再触发，
  #   对撞层/元层可能跑得更久。
  # 【CLI 覆盖】--no-self-check
  self_check: true

  # 【兼容旧字段名】layer_summary 等价于 actions.summarize_views。
  #   保留仅为向后兼容，新配置建议忽略。
  plain_speak: false
  layer_summary: false

  # 【用途】探针 covers 字段诊断日志。
  # 【行为】
  #   false（默认）：只打印异常（字段缺失 / 类型非 list）
  #   true：每次探针都打印 covers_raw → parsed
  # 【建议】只在排查 "探针为什么没 covers" 时开。
  # 【典型日志】
  #   [fix-89 diag] 探针 covers_raw=['T1','T3'] → parsed=['T1','T3']
  #   [fix-89 diag] 探针 covers 字段缺失（模型未输出）
  show_probe_diag: false


# ------------------------------------------------------------
# 逻辑开关（决定"做不做某一步"）
# ------------------------------------------------------------
actions:
  # ---------- 层间调度 ----------

  # 【用途】是否做全局可判定性评估。
  # 【建议】保持 true。
  # 【关闭后】decidability_result 默认 decidable，所有层按"可判定"处理。
  assess_decidability: true

  # 【用途】是否做子问题分解（研究层专用）。
  # 【建议】保持 true。
  # 【关闭后】研究层无 sub_questions，双通道产物退化。
  decompose_question: true

  # 【用途】评估来源（三选一）。
  # 【可选值】
  #   "pool"       —— 从修行池读，并与外部评估合成（最稳，推荐）
  #   "external"   —— 只用外部评估（0 和 1 可并行，A 模式前提）
  #   "pool_only"  —— 只用池评估（省 1 次 LLM 调用）
  # 【选择逻辑】
  #   pool        → 必须先跑 0 层，从修行池读评估
  #                 + 同时跑外部评估，两路合成
  #   external    → 跳过池读，只用外部评估
  #   pool_only   → 只用池评估，不跑外部
  # 【⚠️ A 模式】会被强制改为 external（B~H 有 0 层预热，能走 pool）。
  #   池还没产物），本字段的配置不生效。
  decidability_source: "pool"

  # 【用途】分解来源（二选一）。
  # 【可选值】
  #   "pool"     —— 从修行池探针/&/悬置里生发研究子问题（推荐）
  #   "external" —— 从问题本身重新拆解
  # 【选择逻辑】
  #   pool     → 从修行层产物长，继承修行成果
  #              要求 0 层先跑完（层间依赖强）
  #   external → 从问题本身重新拆解
  #              好处：0 和 1 可并行
  #              坏处：修行层白跑（研究层不继承修行成果）
  # 【⚠️ A 模式】会被强制改为 external（B~H 有 0 层预热，能走 pool）。
  decompose_source: "pool"

  # ---------- ★ v1.21.54 并行模式 ----------
  # 【用途】四层执行策略。
  # 【可选值】
  #   "serial" —— 严格串行（0→1→both→all），最稳（原逻辑）
  #   "A"      —— 四层独立并行 + 汇流圈，快
  #   "B"      —— 轮次并行（Jacobi），每波 barrier，读上一波定格
  #   "C"      —— 流水线并行，只等上游交出第一圈，之后各跑各的
  #   "D"      —— 0∥1 各自跑完 → both 起 → both 出圈后 all 跟上
  #   "E"      —— 0∥1 各自跑完 → both 跑完 → all 起
  #   "F"      —— 0 跑完 → 1 出圈 both 跟上 → both 出圈 all 跟上
  #   "G"      —— 0 跑完 → 1 出圈 both 跟上 → both 跑完 all 起
  #   "H"      —— 0 跑完 → 1 跑完 → both 起 → both 出圈后 all 跟上
  #   "auto"   —— 由 MetaDGTF 按问题性质自动决策
  #
  # 【★ D~H 的一句话区别】只差"哪一层必须先收工"：
  #   记 waits 的层 —— 它**跑完所有圈**下游才动（硬闸）
  #   记 gates 的层 —— 它**交出第一圈**下游就动（软闸）
  #   表在源码 _MODE_GRAPH 里（每个模式 4 行），加新排布改表即可，
  #   跑圈/停止/合并逻辑五档共用同一套（_run_one_round_B）。
  #
  #   ┌────┬──────────────┬──────────────┬────────────────────┐
  #   │模式│ 修行 0       │ 研究 1       │ 对撞 both / 元 all │
  #   ├────┼──────────────┼──────────────┼────────────────────┤
  #   │ D  │ 立即 ∥ 1     │ 立即 ∥ 0     │ both 等 0+1 跑完   │
  #   │    │              │              │ all 等 both 出圈   │
  #   │ E  │ 立即 ∥ 1     │ 立即 ∥ 0     │ both 等 0+1 跑完   │
  #   │    │              │              │ all 等 both 跑完   │
  #   │ F  │ 立即         │ 等 0 跑完    │ both 等 1 出圈     │
  #   │    │              │              │ all 等 both 出圈   │
  #   │ G  │ 立即         │ 等 0 跑完    │ both 等 1 出圈     │
  #   │    │              │              │ all 等 both 跑完   │
  #   │ H  │ 立即         │ 等 0 跑完    │ both 等 1 跑完     │
  #   │    │              │              │ all 等 both 出圈   │
  #   └────┴──────────────┴──────────────┴────────────────────┘
  #
  # 【auto 决策逻辑】
  #   调 LLM 读问题性质，返回模式 + 理由 + 置信度。
  #   低置信（< 0.5）退回 serial。
  #   经验映射：
  #     明确单一问题           → serial
  #     多分句 / 并列          → A
  #     含"或/还是"/过程性      → B
  #     层界清楚、只想快        → C
  #     0/1 互不依赖、撞点是关键→ D
  #     同上 + 元层要最终对撞   → E
  #     修行是地基、后三层接力  → F
  #     元层要清算完整对撞      → G
  #     研究要吃完整修行        → H
  #     拿不准                 → serial
  #
  # 【九模式对比】
  #   ┌────────┬──────────────┬──────┬──────────────────────┐
  #   │ 模式   │ 层间关系     │ 并行 │ 可复现性             │
  #   ├────────┼──────────────┼──────┼──────────────────────┤
  #   │ serial │ 跑完才起     │ 1×   │ ✅                   │
  #   │ A      │ 互不读+汇流  │ 4×   │ ✅                   │
  #   │ B      │ 每波 barrier │ 4×   │ ✅                   │
  #   │ C      │ 首圈放行     │ ~4×  │ ❌ 时序依赖          │
  #   │ D      │ 0∥1→撞→元   │ ~2×  │ ❌ all 读活对撞      │
  #   │ E      │ 0∥1→撞→元   │ ~2×  │ ⚠️ 1 与 0 并发抢池   │
  #   │ F      │ 全流水       │ ~2×  │ ❌ 时序依赖          │
  #   │ G      │ 撞毕收元     │ ~2×  │ ❌ both 读活研究     │
  #   │ H      │ 逐层接力     │ ~2×  │ ❌ all 读活对撞      │
  #   └────────┴──────────────┴──────┴──────────────────────┘
  #   D/E 的"0∥1 并发"有个副作用：研究层读修行池分解子问题时，
  #   修行层可能正在往池里写 —— 严格讲是竞态。
  #   想要完全去掉它，把 parallel_warmup_rounds 设到 ≥0 层 hard_max
  #   （0 层整层先行），或改用 F/G/H。
  #
  # 【曾经的坑 · v1.21.51 [fix-105] 已修】
  #   --parallel 的 argparse default 原来是硬编码 "auto"，
  #   不传也会覆盖本字段。现在 default=None，
  #   不传时回落本文件的 parallel_mode —— 本字段真正生效。
  #   显式传 --parallel 仍然覆盖本字段（这是想要的）。
  #
  # 【CLI 覆盖】--parallel serial|A|B|C|D|E|F|G|H|auto
  # 【交互模式】会单独询问，回车用 auto
  parallel_mode: "auto"

  # ---------- ★ v1.21.54 B~H 的 0 层预热 ----------
  # 【用途】B/C/D/E/F/G/H 模式下，0 层先单独跑几圈做预热，
  #         再带着进度回到并行队列（A 模式不看本字段）。
  #
  # 【为什么需要】不预热的话：
  #   · 研究层第 1 圈读不到修行池 → decompose_source 退回 external，
  #     修行层等于白跑，研究层不继承修行成果；
  #   · 对撞层第 1 圈没有两侧可对齐 → 只能写空对齐占位；
  #   · 可判定性只能拿问题字符串本身当判据。
  #
  # 【可选值】
  #   1（默认）—— 只预热一圈，之后 0 层从第 2 圈接着跑。
  #               正确性（走池路径）和时间（不整层串行）两头都要。
  #   0        —— 完全不预热。
  #               代价：可判定性退回 external，研究层退回外部分解。
  #   ≥0 层 hard_max —— 整层先行（v1.21.52 的行为）。
  #               最稳也最慢：0 层那段是完全串行的瓶颈。
  #
  # 【D/E 特别注意】这两种模式用户描述是"修行和研究一起开始"。
  #   本字段默认 1 时，修行层先跑一圈，研究层晚一圈才出发 ——
  #   换来研究层能读到修行池、可判定性走 pool+external。
  #   要字面意义的严格同时出发：把本字段设 0（代价见上）。
  #
  # 【调法】
  #   在乎可判定性判得准 → 2 ~ 3（池里材料更多，池视角判定更准）
  #   在乎速度           → 1
  #   做对照实验          → 0 与 ≥hard_max 各跑一遍对比
  parallel_warmup_rounds: 1

  # 【用途】C/D/E/F/G/H 模式层间放行的最长等待（秒）。
  #         上游线程崩了或卡死时不至于把下游一起吊死。
  #         每层线程 finally 里都会放行，超时只是双保险。
  # 【建议】900。
  # 【调大】单次 reasoner 调用经常逼近 api.timeout 时往上调。
  pipeline_gate_timeout: 900

  # ---------- 层内动作（每层每圈依次执行）----------

  # 【用途】是否重述锚点。
  # 【建议】true。
  # 【关闭后】锚点用原文，省 1 次 LLM 调用/圈。
  re_anchor: true

  # 【用途】阴视角展开（0 端）。
  # 【建议】true。关了候选会偏向一边。
  expand_yin: true

  # 【用途】阳视角展开（1 端）。
  # 【建议】true。关了候选会偏向一边。
  expand_yang: true

  # 【⚠️ 强烈建议不要关】DGTF 核心机制。
  # 【用途】对偶判断：判候选的 position（0/1/both）。
  # 【关闭后果】全部候选 position=0，& 无出生。
  dual_judge: true

  # 【⚠️ 强烈建议不要关】DGTF 核心机制。
  # 【用途】ing 对撞（六步展开）。
  # 【关闭后果】无对撞，& 沉淀无输入。
  ing: true

  # 【⚠️ 强烈建议不要关】DGTF 核心机制。
  # 【用途】& 沉淀（提取 & 印记 / 线头 / 元反思）。
  # 【关闭后果】池子不长。
  he: true

  # 【用途】探针回归（生发下一圈 seeds）。
  # 【建议】true。
  # 【关闭后果】无 seeds，下一圈从零开始。
  phase_probe: true

  # 【用途】view 显形（生成 manifest）。
  # 【建议】true。
  # 【关闭后】view 全为"（manifest 动作已关闭）"，省 1 次 reasoner 调用/圈。
  manifest: true

  # 【用途】self-check（自省）。
  # 【⚠️ 与 output.self_check 是同一个开关】。
  # 【建议】true。
  # 【关闭后果】streak 机制失效（fix-72 v3 不触发）。
  self_check: true

  # ---------- 展示类动作 ----------
  # 【兼容旧字段名】保留，新配置建议忽略。
  plain_speak: false
  summarize_views: false

  # ---------- 池维护 ----------

  # 【用途】每圈重估池中 & / 线头的极性。
  # 【建议】true。
  # 【关闭后果】池极性永远 "?"，polarity_all_same 误报，
  #             探针筛选的极性加权失效。
  re_evaluate_pool: true

  # 【用途】研究层跑完后债务终局清算。
  # 【建议】true。
  # 【关闭后果】延迟债务悬空（clean=False）。
  settle_research: true


# ------------------------------------------------------------
# 探针筛选参数
# ------------------------------------------------------------
probe:
  # 【用途】探针最低 expected_gain，低于此值丢弃。
  # 【建议】
  #   默认 0.3
  #   探针总为空     → 0.2
  #   探针质量差     → 0.4 ~ 0.5
  min_gain: 0.3

  # 【用途】每圈从新探针中筛出几条进下一轮。
  # 【建议】
  #   默认 3
  #   圈数少但想多跑 → 5
  # 【注意】太多会稀释注意力。
  select_n: 3


# ------------------------------------------------------------
# 三通道记忆参数
# ------------------------------------------------------------
memory:
  # 【用途】三通道：
  #   content —— 内容通道：读上游 View 的形状（candidates/amps/threads）
  #   context —— 背景通道：读上游已跑层的摘要
  #   self    —— 自我通道：跨问题累积"我上次是谁"
  #
  # 【建议】不要关 content。
  #   context / self 可视情况关（省 prompt 长度）。
  #
  # 【关闭影响】
  #   关 content → 展开/对偶判断看不到池和历史，退化为"每次从零开始"
  #   关 context → 对撞层看不到修行/研究的来路，可能误判张力
  #   关 self    → 无跨问题记忆，单次运行不受影响
  #
  # 【全关】用 [] 或 ["none"]
  # 【CLI 覆盖】--channels content,context,self
  channels: ["content", "context", "self"]

  # 【用途】self 通道保留最近几层的记忆。
  # 【建议】4。
  self_layers: 4

  # 【用途】池形状注入 prompt 时最多几条。
  # 【建议】6。
  # 【调大】给 LLM 更多上下文，但 prompt 变长。
  shape_items: 6

  # 【用途】每条形状截断字符数。
  # 【建议】900。
  shape_chars: 900

  # ---------- ★ v1.21.55 自省回流（[P1-5] 引入，[P2-7] 修好）----------
  # 【用途】把每一圈 self-check 的结论变成下一圈的硬约束。
  #   · 可疑候选      → 下一圈禁止原样/换说法/扩写重述（kind=candidate）
  #   · ing 复述=True → 下一圈 ing 必须写上游 view 没有的句子（kind=ing）
  #   · both 配额缺项 → 下一圈把缺的东西生出来、裁成 0/1（kind=dual）
  #   · 「此处未生」>3 处 → 下一圈不许再拿未生收尾（kind=any）
  #
  # 【关掉的代价】自省会照常抓到"候选凑数""ing 复述=True"，
  #   然后什么都不会发生 —— 花一次调用做质检，结论只进 md。
  #   这是 v1.21.52~v1.21.54 实测产物里的现象。
  #
  # 【为什么以前看着没生效（[P2-7] 已修）】
  #   约束原来混进 seed_probes，渲染成"上一圈没带走的自问"——
  #   一条普通探针，模型当参考看，不当约束听。
  #   现在走独立通道（Input.carry_constraints）：
  #     置顶进展开 prompt 的硬约束块，并按 kind 分流进 ing / 对偶判断。
  #   同时每圈多了【自省回流核对】：禁条目有没有重现、
  #   ing 复述率有没有降，结论进 md 的【自省回流核对】段。
  #
  # 【调试】想看注入了什么：开 output.verbose，
  #   找日志里的 "🔁 [自省回流]" 与 "✅/⚠️ [自省回流核对]"。
  carry_feedback: true


# ------------------------------------------------------------
# 螺旋停止 / 循环判据
# ------------------------------------------------------------
spiral:
  # ---------- 圈数控制 ----------

  # 【用途】软最大圈数：超过它才开始检查"自然安住"。
  # 【建议】3。
  # 【注意】soft_max 必须 < hard_max 才能触发自然安住。
  soft_max: 3

  # 【用途】硬最大圈数：体力上限，走满即截断。
  # 【建议】
  #   开发调试：4
  #   日常：8
  #   深度研究：12-15
  #   批量：6
  # 【注意】走满时 stop_reason 会写"体力耗尽...是被截断不是自然停止"。
  hard_max: 12

  # 【用途】元层额外多跑 N 圈（用于闭环清算）。
  # 【建议】1。
  # 【关闭】0。
  all_extra_rounds: 1

  # ---------- 停止判据阈值 ----------
  # 【调松（更早停）↔ 调严（跑更久）】

  # 【用途】产物相似度阈值：连续两圈 view 相似 ≥ 此值 → 自然安住。
  # 【建议】0.8。
  # 【调松】0.7（更早停）。
  # 【调严】0.9（跑更久）。
  stop_similarity: 0.8

  # 【用途】悬置稳定所需条数。
  # 【建议】2。
  # 【调松】1。【调严】3。
  stable_need: 2

  # 【用途】悬置转稳所需的连续层数。
  # 【建议】3。
  # 【调松】2（更早停）。【调严】4。
  stable_layers: 3

  # 【用途】判定"同一批"的相似度阈值。
  # 【建议】0.6。
  batch_similarity: 0.6

  # 【用途】元层闭环清算的覆盖相似度阈值。
  # 【建议】0.6。
  meta_cover_similarity: 0.6

  # 【用途】空转上限：连续 N 圈 idle 即停。
  # 【建议】2。
  # 【调松】1。【调严】3。
  idle_limit: 2

  # 【用途】每圈空转上限：连续 N 圈无新 & / 线头即停。
  # 【建议】2。
  # 【调松】1。【调严】3。
  round_idle_limit: 2

  # ---------- 新条目判据 ----------

  # 【用途】新条目相似度阈值（辅助判据）。
  # 【建议】0.55。
  # 【调松】0.7（更容易判"重复"）。【调严】0.4。
  new_item_similarity: 0.55

  # 【用途】新条目 overlap coefficient 阈值（主判据）。
  # 【说明】overlap = |A∩B| / min(|A|,|B|)，
  #         比 Jaccard 对长短不均的句子更宽容。
  # 【建议】0.55。
  new_item_overlap: 0.55

  # ---------- ★ v1.21.49 线程去重（比候选更严）----------
  # 【原因】修行/对撞层换措辞的线头被算作"新"，
  #         导致 11 圈不触发"无线头新增"。
  # 【建议】0.70 / 0.70。
  thread_new_similarity: 0.70
  thread_new_overlap: 0.70

  # ---------- 结构饱和度检查 ----------

  # 【用途】LLM 判断"是否引入新结构维度"。
  # 【建议】true。
  # 【关闭后果】无"无新维度"停止判据，研究层可能跑更久。
  structure_saturation_enabled: true

  # 【用途】每 N 圈检查一次结构饱和度。
  # 【建议】
  #   默认 2
  #   研究层放宽到 3（v1.21.49 调整）
  # 【注意】
  #   every_n: 1 → 每圈都跑 LLM，慢
  #   every_n: 3 → 3 圈才检查一次，可能错过
  #   该检查额外消耗 LLM 调用（每 N 圈 1 次）。
  # 【仅触发】entry in ("1", "all")。
  structure_saturation_every_n: 2

  # ---------- 跨圈比对窗口 ----------

  # 【用途】跨圈比对时往前看几圈。
  # 【建议】2。
  round_window: 2

  # 【用途】连续有新增但无推进的上限。
  # 【建议】2。
  round_stall_limit: 2

  # ---------- 入池挡重复 ----------

  # 【用途】入池前挡重复的相似度阈值。
  # 【建议】0.6 ~ 0.7。
  # 【⚠️ 太低会误杀】0.3 → 稍有相似就判"翻回老地方"，池永远长不大。
  rehash_similarity: 0.6

  # ---------- 双通道停滞 ----------

  # 【用途】双通道停滞判据：qdist 无改善连续 N 次。
  # 【建议】2。
  stall_streak_limit: 2

  # 【用途】qdist 最小改善量。
  # 【建议】0.03。
  min_distance_improvement: 0.03

  # 【用途】双通道收敛窗口。
  # 【建议】2。
  convergence_window: 2

  # ---------- ★ v1.21.55 「此处未生」阈值 ----------
  # 【用途】一圈的产物里，「此处未生」出现超过几处就判为**逃避**。
  #   「此处未生」是宪法允许的诚实姿态（折中不合法，未生合法）。
  #   但每次都拿它收尾就成了套路：探针没真的往里推，
  #   用一句「未生」把该走的路结掉。这个字段就是那条分界线。
  #
  # 【统计口径】代码按产物硬数一遍（ing / view / 线头 / & /
  #   不可判定通道），与模型自报的 unsaid_count 取**较大值**——
  #   模型靠少报藏不住。
  #
  # 【建议】3。
  #   调大（4~6）→ 更宽容，适合本来就难推的问题（如不可判定类）
  #   调小（1~2）→ 更严，适合要逼出实际产物的场景
  #   0         → 不设限，永远只当诚实姿态，不做判据
  #
  # 【触发后发生什么】
  #   quality_flags 加 unsaid_overused(n)（进质量评价）
  #   self_check.unsaid_is_escape = true
  #   下一圈注入一条硬约束：「不许再拿未生收尾，
  #     先把上一圈标了未生的地方真的推一遍」
  #
  # 【按层覆盖】per_entry."0".unsaid_escape_limit: 5
  #   例：修行层本来就常以「未生」收尾，可以只对它放宽。
  #
  # 【看结果】md 每段末尾的【「此处未生」计数】。
  unsaid_escape_limit: 3

  # ---------- 极性重估 ----------

  # 【用途】极性重估频率（每 N 圈跑一次）。
  # 【建议】1（每圈）。
  # 【关闭】配合 actions.re_evaluate_pool: false。
  re_eval_every_n: 1

  # 【用途】极性重估取池尾几条。
  # 【建议】10。
  re_eval_recent_k: 10

  # ---------- 每层最低圈数 ----------
  # 【用途】低于此值不允许停止（拦截早停）。
  # 【⚠️ 注意】会覆盖停止判据：
  #   即使"材料耗尽"命中，圈数未到 min_rounds 也不会停。
  # 【建议】默认全 0（不强制）。
  # 【按层调整】确实需要最低圈数的层再设。
  min_rounds:
    "0": 0
    "1": 2       # 研究层：至少 2 圈才能长出子问题深入
    "both": 3    # 对撞层：至少 3 圈才能走完"摊开→深入→收束"
    "all": 0

  # ---------- 按层覆盖参数 ----------
  # 【⚠️ per_entry 是浅合并，不是整体替换】
  #   实际执行：
  #     sp = dict(config["spiral"])         # 先拿顶层
  #     sp.update(per_entry[entry])         # 再用 per_entry 覆盖
  #     sp.pop("per_entry", None)
  #   → 未列出的字段仍从顶层 spiral 继承。
  #
  # 【如果你想为某层完全隔离配置】
  #   必须把该层所有要覆盖的字段都写出来。
  per_entry:
    # 修行层：硬上限 6 圈
    # 【原因】产出是"视角展开"，不需要太多圈
    "0":
      hard_max: 6

    # 研究层：结构饱和度检查放宽到每 3 圈一次
    # 【原因】v1.21.49 从 2 圈放宽到 3 圈，
    #         因为 v1.21.48 研究层 2 圈就停，可判定覆盖率仅 33%
    "1":
      structure_saturation_every_n: 3

    # 对撞层：软最大提高到 5 圈（原 3）
    # 【原因】让"摊开→深入→收束"至少走完一轮
    "both":
      soft_max: 5

    # 元层：悬置转稳只需 2 层；结构饱和度检查每 3 圈
    # 【原因】元层多跑收益递减；结构饱和度放宽避免过早停
    "all":
      stable_layers: 2
      structure_saturation_every_n: 3


# ============================================================
# 三套推荐配置（按需切换）
# ============================================================
#
# 【场景 1 · 开发调试】
#   想快速定位问题，用便宜模型，跑得短。
#   ------------------------------------------------------------
#   api:
#     reasoner_model: "deepseek-chat"      # 调试时用便宜模型
#   output:
#     verbose: true
#     show_dual_judge: true
#     show_ing: true
#     show_manifest: true
#     show_probe_diag: true
#   actions:
#     parallel_mode: "serial"              # 调试用串行，好定位
#   spiral:
#     hard_max: 4
#     per_entry:
#       "0": { hard_max: 2 }
#       "1": { hard_max: 2 }
#       "both": { hard_max: 2 }
#       "all": { hard_max: 2 }
#
# ------------------------------------------------------------
# 【场景 2 · 日常使用】
#   平衡速度与质量。
#   ------------------------------------------------------------
#   actions:
#     parallel_mode: "auto"
#   output:
#     verbose: true
#     self_check: true
#   spiral:
#     hard_max: 8
#     per_entry:
#       "0": { hard_max: 5 }
#       "1": { hard_max: 7, structure_saturation_every_n: 3 }
#       "both": { soft_max: 5, hard_max: 6 }
#       "all": { hard_max: 5 }
#
# ------------------------------------------------------------
# 【场景 3 · 批量生产】
#   多问题并行，最省成本，最安静。
#   ------------------------------------------------------------
#   output:
#     verbose: false
#     self_check: false                    # 省 1 次/圈
#   actions:
#     parallel_mode: "C"                   # 最快（A 也可，见下）
#     re_evaluate_pool: false              # 省 1 次/圈
#   spiral:
#     hard_max: 6                          # 压低预算
#     all_extra_rounds: 0
#     per_entry:
#       "0": { hard_max: 4 }
#       "1": { hard_max: 5 }
#       "both": { hard_max: 4 }
#       "all": { hard_max: 4 }
#
#   A 与 C 的取舍：
#     A —— 四层互不相干地跑完再汇流，结果确定，但 both/all 的
#          "读上游"语义是退化后靠汇流圈补回来的。
#     C —— 每层真的在读上游（部分受限地保留了 both/all 语义），
#          也最快，但结果带时序依赖，跑两次可能不一样。
#     批量且不需要复现 → C；批量但要能对着上一版复盘 → A。
#
# ============================================================


# ============================================================
# 调试与诊断速查
# ============================================================
#
# 【想知道为什么停止了】
#   看 outputs/*.md 里的 **螺旋停止** 字段，
#   或日志里的 ⏹ 螺旋停止（第 N 圈）。
#   停止理由可能是多条拼起来的：
#     "产物相似度高，自然安住 + 连续 2 轮无新 &"
#   排查顺序：
#     1. 看 round_log 表格，找到哪一圈先触发
#     2. 对比 idle_amp / idle_thread / idle_stall 是否超阈值
#     3. 若"产物相似" → 调 stop_similarity
#     4. 若"无新 &"  → 调 new_item_overlap
#
# 【想看探针为什么没 covers】
#   output.show_probe_diag: true
#   日志会出现：
#     [fix-89 diag] 探针 covers_raw=['T1','T3'] → parsed=['T1','T3']
#   或：
#     [fix-89 diag] 探针 covers 字段缺失（模型未输出）
#
# 【想看 ing 复述率】
#   默认不打印。看 view.quality_flags：
#     ing_rephrased_direct(75%)
#   百分数是复述率。若 ≥ 50%，_ing_rephrase_ratio 被设置。
#
# 【想看池极性分布】
#   每次跑池快照会打印：
#     📋 池极性快照（1 第 3 圈，共 12 条，未判 2 条）：
#           & [1] 前端设计的责任边界
#           & [0] 验证环节的归属
#           ... [both] 需求到实现的转换
#   [?] 是未判的，re_evaluate_pool: true 后会补上。
#
# 【想看某个动作的开销】
#   output.verbose: true
#   跑完后会打印：
#     完成 | 87 次 LLM | 132456 tokens
#   单层单圈约 10 次 LLM：
#     re_anchor        1 次
#     expand_yin/yang  2 次
#     dual_judge       1-3 次
#     ing              1 次（reasoner）
#     he               1 次
#     phase_probe      1 次
#     manifest         1 次（reasoner）
#     self_check       1 次
#     re_evaluate_pool 1 次
#     结构饱和度        1 次/N 圈
#
# ============================================================


# ============================================================
# 常见坑与陷阱（速查表）
# ============================================================
#
# 【坑 1】--parallel 默认值覆盖 YAML（v1.21.51 [fix-105] 已修）
#   现象（旧版）：YAML 里写 parallel_mode: "A"，CLI 不传 --parallel，
#               实际跑的是 "auto"。
#   原因：argparse default="auto" 硬编码。
#   现状：default 改成 None，不传就回落本文件的 parallel_mode。
#   仍然要注意：显式传 --parallel 会覆盖本文件（这是想要的）。
#
# 【坑 1.5】C 模式结果不可复现
#   现象：同一个问题跑两遍，both/all 的产物不一样。
#   原因：C 是流水线，both 的第 2 圈读到 0 的第几圈取决于谁先跑完。
#   想可复现 → 用 B（每圈 barrier）或 serial。
#   想最快 → 用 C。两者不能兼得。
#
# 【坑 2】per_entry 是浅合并
#   现象：per_entry."1".structure_saturation_every_n: 3
#         期望 "1" 层完全隔离配置，
#         实际 hard_max 仍继承顶层 12。
#   修法：把该层所有要覆盖的字段都写出来。
#
# 【坑 3】A 模式强制走 external（B~H 已不用强制了）
#   现象：decidability_source: "pool" 配了，A 模式实际走 external。
#   原因：A 模式四层互不读产物，池里没有东西可读。
#   修法：设计如此，A 模式本来就不继承。
#
#   B/C/D/E/F/G/H 模式不同 —— v1.21.53 加了 0 层预热之后
#   它们都能走池路径（_source = pool+external）。
#   但预热圈数决定这条路走不走得成：
#     parallel_warmup_rounds = 0   → 退回 external
#     parallel_warmup_rounds >= 1  → 走池路径 ✅
#   所以看到 B~H 的判定源是 external 时，先查这个字段。
# 【坑 4】self_check: false 会让 fix-72 失效
#   现象：对撞/元层跑得比预期久。
#   原因：_rephrased_streak / meta_idle_streak 不累积，
#         fix-72 v3 不再触发。
#   修法：除非调试速度，保持 self_check: true。
#   v1.21.55 起还多一条：self_check 关掉 → _build_carry 没有输入，
#         memory.carry_feedback 形同虚设（自省结论不再回流）。
#         两个开关是串在同一条链上的。
#
# 【坑 5】rehash_similarity 太低会误杀
#   现象：池永远长不大，每次都"翻回老地方"。
#   原因：0.3 太低，稍有相似就判重复。
#   修法：保持 0.6 ~ 0.7。
#
# 【坑 6】min_rounds 会覆盖停止判据
#   现象：即使"材料耗尽"命中，层仍继续跑。
#   原因：min_rounds 拦截早停。
#   修法：默认全 0；确实需要最低圈数的层再设。
#
# 【坑 7】批量跑时共享 LLM 实例
#   现象：无法区分哪个问题花了多少 LLM 调用。
#   原因：多 MetaDGTF 共享一个 LLM，计数累加正确但无归属。
#   修法：每个问题用独立 MetaDGTF（默认行为）。
#
# ============================================================


# ============================================================
# 版本升级注意事项
# ============================================================
#
# 【v1.21.55 第二批（跑出第一份真模型产物之后的修订）】
#   （同一版本号内的第二批改动，编号 P2-9a ~ P2-9g，见主文件 changelog）
#   新增字段：无。
#   兼容性：
#     ✅ 旧的 dgtf_config.yaml 可直接用，不改也能跑
#   行为变化（比上一批影响更直接，注意）：
#     ⚠️ 自省回流现在是**硬执行**：上一圈点名禁掉的候选，
#        这一圈再写出来会被当场丢掉（md 里多一段
#        【回流硬执行 · 拦下的重现候选】）。
#        保底留一半、且至少留一条 —— 全丢会把层内的
#        自省 → 回流链路一起掐断。
#        想回到旧行为（只记录不拦）：memory.carry_feedback: false。
#     ⚠️ 角色排班改了：有 carry 时 2 圈 = 摊开 → 转向、
#        3 圈 = 摊开 → 转向 → 复裁。原来是永远「摊开」
#        （被自己的返回值喂回去了）。本轮形状那段文案会跟着变。
#     ⚠️ 展开的量词从「输出 0-8 条」改成「能写几条写几条」，
#        且【宁可空，不要凑】挪到 prompt 最前面。
#        候选条数会比上一批少，这是目的不是故障。
#     ⚠️ md 的「上限 N 圈」改成 rounds_cap：元层会显示
#        请求圈数 + spiral.all_extra_rounds（默认 1）。
#     ⚠️ 自省段多一行「ing 复述率（代码实算）」。
#        模型自判与它不一致时（元层见过 False vs 50%），
#        以这一行为准去裁决；两者的阈值 0.75 / 0.62 仍未做成配置项，
#        样本够了再说。
#     （以上都不需要改配置；没有新的可配开关。）
#
# 【v1.21.54 → v1.21.55】
#   新增字段：
#     spiral.unsaid_escape_limit: 3   ← 新增，有默认值
#     memory.carry_feedback: true     ← 字段 v1.21.52 [P1-5] 就有，
#                                       本文件此前没写出来，这次补上
#   （两者都有默认值，旧的 dgtf_config.yaml 不改也能跑。）
#   兼容性：
#     ✅ 旧的 dgtf_config.yaml 可直接用，不改也能跑
#   行为变化（都是判据纠偏，不改调度）：
#     ⚠️ 自省回流现在真的进下一圈 prompt，且每圈多一段【自省回流核对】。
#        产物会比 v1.21.54 更"被约束"：可疑候选不许重现、
#        ing 不许复述上游。想回到旧行为：memory.carry_feedback: false。
#     ⚠️ 对偶判断允许少判（judgments 条数 < 候选条数）。
#        日志里会出现 "🔮 未判 N/M 条"，这是合法的，不是失败；
#        只有"一条都没判到"才记 error。
#     ⚠️ ing 复述率不再把本层候选算作"上游"。
#        同样的输出，复述率数字会比 v1.21.54 低（以前把吃候选也算成复述）。
#        换说法（扩写）现在也能抓到 —— 判据补了 overlap coefficient。
#     ⚠️ self_check 多报两项：unsaid_count / unsaid_is_escape。
#        一圈里「此处未生」超过 3 处会被标 unsaid_overused(n)，
#        并把"不许再拿未生收尾"回流进下一圈。
#        阈值走 spiral.unsaid_escape_limit（默认 3，
#        per_entry."0".unsaid_escape_limit 可按层覆盖；0 = 不设限）。
#        代码里的 UNSAID_ESCAPE_LIMIT = 3 只是没读到配置时的兜底。
#     ⚠️ md 每层末尾新增两段：【「此处未生」计数】、【自省回流核对】。
#        此前这两块只在 view.rendered（日志）里，md 里查不到。
#     ⚠️ 修行层探针多了 threads 字段：
#        材料不够 / 工具限制 / 外部约束这类"推不动"的硬边界进 threads，
#        不再占 suspensions（主动悬置）。产物里"我决定不碰什么"会变短，
#        "悬空线头"会变长——这是刻意的，不是丢东西。
#
# 【v1.21.53 → v1.21.54】
#   新增字段：无（复用 parallel_warmup_rounds / pipeline_gate_timeout）
#   parallel_mode 新增可选值："D" "E" "F" "G" "H"
#   兼容性：
#     ✅ 旧的 dgtf_config.yaml 可直接用，不改也能跑
#     ✅ 默认仍是 auto，auto 现在九选一
#   行为变化（不影响已有模式）：
#     ✅ serial / A / B / C 的调度逻辑一行没动
#     ⚠️ auto 的候选集从 4 个扩到 9 个，
#        觉得选得飘就把 parallel_mode 写死成某一档
#   新增默认值：
#     parallel_warmup_rounds 现在也作用于 D/E ——
#     默认 1 意味着 D/E 的研究层比修行层晚一圈出发。
#     想要严格同时出发，显式设为 0。
