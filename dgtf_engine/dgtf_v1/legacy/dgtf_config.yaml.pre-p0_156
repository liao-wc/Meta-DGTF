# ============================================================
# 性能与成本估算
# ============================================================
#
# 【时间估算】假设单次 LLM 平均 5 秒（chat）/ 15 秒（reasoner）
#   ┌────────┬──────────────────┬──────────────┬────────────┐
#   │ 模式   │ 四层 3 圈的调用数 │ 时间估算     │ 可复现性   │
#   ├────────┼──────────────────┼──────────────┼────────────┤
#   │ serial │ 4 层 × 3 圈 × 10 │ ~600 秒      │ ✅         │
#   │ A      │ 3 圈 × 10 × 4    │ ~180 秒      │ ✅         │
#   │ B      │ 3 圈 barrier     │ ~200 秒      │ ✅         │
#   │ C      │ 流水线，无 barrier│ ~150 秒      │ ❌ 时序依赖│
#   │ D      │ 0∥1 后两段       │ ~300 秒      │ ❌ 时序依赖│
#   │ E      │ 0∥1 后两段串行   │ ~380 秒      │ ⚠️ 并发抢池│
#   │ F      │ 0 先行后全流水   │ ~230 秒      │ ❌ 时序依赖│
#   │ G      │ 0 先行，撞毕收元 │ ~300 秒      │ ❌ 时序依赖│
#   │ H      │ 逐层接力         │ ~340 秒      │ ❌ 时序依赖│
#   └────────┴──────────────────┴──────────────┴────────────┘

#   调用总数上 C 和 A/B 差不多（同一批 LLM 调用），
#   差别在墙钟时间：A/B 每圈/每波要等最慢的一层，
#   C 每层自己往下走，只有开头那一个圈要排队。
#   实测（冒烟 mock 环境，四层各 2 圈）：
#     serial 79 次 / A 89 次 / B 78 次 / C 76 次调用。
#
# 【成本估算】以 deepseek-chat 为例
#   单次完整运行：80-150 次 LLM 调用
#   平均输入：~2000 token（含 prompt + 池形状）
#   平均输出：~800 token
#   总 token：~280k
#   成本估算：¥0.5 ~ ¥1 / 问题
#
#   reasoner 模型贵 5-10 倍（ing / manifest 各占 1 次/圈）。
#
# 【省钱建议】
#   self_check: false            → 省 1 次/圈
#   re_evaluate_pool: false      → 省 1 次/圈
#   manifest: false              → 省 1 次 reasoner 调用/圈
#   structure_saturation_every_n: 4  → 省 1 次/几圈
#
# ============================================================