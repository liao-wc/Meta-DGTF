# -*- coding: utf-8 -*-
"""元DGTF 应用层 · HTTP 服务（含登录与多用户隔离）。

纯标准库 ThreadingHTTPServer。路由：

  公开（只是页面空壳与静态资源，不含任何用户数据）
  GET  /  /index.html  /login         → static/index.html（登录闸门在页面内完成）
  GET  /static/<file>                 → 静态资源（登录卡也要用，不可拦）
  POST /api/auth/login                → {username, password} → 下发会话 Cookie
  POST /api/auth/register             → 仅当开放注册时可用
  POST /api/auth/logout               → 注销当前会话
  GET  /api/auth/me                   → 当前用户 + 每日配额（未登录回 401）

  业务（均需登录）
  GET  /api/config                    → 引擎版本 / 凭据状态（不泄露值）/ 产物统计
  GET  /api/tasks                     → 任务列表（仅本人）
  POST /api/tasks                     → 新建任务 {question, opts}
  GET  /api/tasks/<id>                → 单任务状态
  GET  /api/tasks/<id>/log?offset=N   → 日志增量（按字节偏移）
  POST /api/tasks/<id>/cancel         → 取消任务
  GET  /api/tasks/<id>/result         → 产物正文
  GET  /api/outputs?q=&body=&days=…   → 历史产物列表 / 检索
  GET  /api/outputs/facets            → 筛选项集合
  GET  /api/outputs/<name>            → 单份产物正文

启动： python dgtf_app/server.py [--port 8765] [--verbose]

⚠️ 多用户隔离：请求进入时解析会话 Cookie → req_user；所有任务与产物接口
   都按该用户过滤，跨用户访问一律返回 404（不泄露存在性）。

⚠️ 登录不换页：首页始终返回 index.html，未登录时前端就地显示登录闸门；
   服务端只保证「数据接口」需要登录（未登录一律 401），页面本身不含数据。
"""

from __future__ import annotations

import argparse
import json
import mimetypes
import os
import re
import sys
from http.cookies import SimpleCookie
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from urllib.parse import unquote, parse_qs, urlparse

APP_DIR = Path(__file__).resolve().parent
STATIC_DIR = APP_DIR / "static"
sys.path.insert(0, str(APP_DIR))

import auth as A  # noqa: E402
import engine_runner as runner  # noqa: E402
import library as lib  # noqa: E402
import outputs_index as oi  # noqa: E402
import params as prm  # noqa: E402

_FACETS = ("decidability", "orientation", "parallel", "stop")


class Handler(BaseHTTPRequestHandler):
    server_version = "DGTFApp/1.0"

    def log_message(self, fmt, *args):  # 默认静默，--verbose 才打访问日志
        if getattr(self.server, "verbose", False):
            super().log_message(fmt, *args)

    # ── 响应助手 ──────────────────────────────────────────────────
    def _json(self, obj, code: int = 200, extra_headers: list | None = None):
        data = json.dumps(obj, ensure_ascii=False).encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        # ⚠️ 安全响应头：禁止被 iframe 嵌套（防点击劫持）、禁止 MIME 嗅探
        self.send_header("X-Content-Type-Options", "nosniff")
        self.send_header("X-Frame-Options", "DENY")
        for k, v in (extra_headers or []):
            self.send_header(k, v)
        self.end_headers()
        self.wfile.write(data)

    def _read_json(self) -> dict:
        n = int(self.headers.get("Content-Length") or 0)
        if not n:
            return {}
        if n > 1_000_000:          # ⚠️ 限制请求体，防超大 payload 打爆内存
            return {}
        try:
            return json.loads(self.rfile.read(n).decode("utf-8"))
        except (ValueError, UnicodeDecodeError):
            return {}

    def _serve_static(self, rel: str):
        rel = rel.split("?", 1)[0].lstrip("/")
        base = STATIC_DIR.resolve()
        target = (base / rel).resolve()
        if base not in target.parents and target != base:
            return self._json({"error": "forbidden"}, 403)
        if not target.is_file():
            return self._json({"error": "not found"}, 404)
        ctype = mimetypes.guess_type(str(target))[0] or "application/octet-stream"
        if ctype.startswith("text/") or ctype in ("application/javascript", "application/json"):
            ctype += "; charset=utf-8"
        data = target.read_bytes()
        self.send_response(200)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")   # 登录页等不应被缓存
        self.send_header("X-Content-Type-Options", "nosniff")
        self.end_headers()
        self.wfile.write(data)

    # ── 会话 ──────────────────────────────────────────────────────
    def _cookie_token(self) -> str:
        raw = self.headers.get("Cookie") or ""
        if not raw:
            return ""
        try:
            c = SimpleCookie()
            c.load(raw)
            m = c.get(A.COOKIE_NAME)
            return m.value if m else ""
        except Exception:  # noqa: BLE001
            return ""

    def _current_user(self) -> dict | None:
        """解析 Cookie → 用户；带 2 秒级缓存，避免每请求都查库。"""
        token = self._cookie_token()
        if not token:
            return None
        return A.check_session(token)

    def _client_ip(self) -> str:
        return (self.headers.get("X-Forwarded-For", "").split(",")[0].strip()
                or self.client_address[0] if self.client_address else "")

    def _set_session_cookie(self, token: str):
        """⚠️ HttpOnly：JS 读不到，防 XSS 窃取；SameSite=Lax 缓解 CSRF。"""
        parts = [f"{A.COOKIE_NAME}={token}", "Path=/", "HttpOnly", "SameSite=Lax",
                 f"Max-Age={A.SESSION_TTL}"]
        if os.environ.get("DGTF_APP_COOKIE_SECURE") == "1":
            parts.append("Secure")     # 上 HTTPS 后开启
        return [("Set-Cookie", "; ".join(parts))]

    def _clear_session_cookie(self):
        return [("Set-Cookie", f"{A.COOKIE_NAME}=; Path=/; HttpOnly; "
                               "SameSite=Lax; Max-Age=0")]

    def _require_login(self) -> dict | None:
        """未登录时返回 401（API）。返回 None 表示已拦截，调用方直接 return。"""
        u = self._current_user()
        if u is None:
            self._json({"error": "未登录", "code": "UNAUTHORIZED"}, 401)
            return None
        return u

    # ── 认证接口 ──────────────────────────────────────────────────
    def _auth_login(self):
        data = self._read_json()
        username = (data.get("username") or "").strip()
        password = data.get("password") or ""
        if not username or not password:
            return self._json({"error": "用户名和密码不能为空"}, 400)

        u = A.get_user_by_name(username)
        # ⚠️ 无论「用户不存在」还是「密码错误」都返回同一句提示，防账号枚举；
        #    且对不存在的用户也做一次哈希运算，抹平响应时间差（防时序侧信道）。
        ok = A.verify_password(password, u["password_hash"]) if u else False
        if not u or not ok:
            return self._json({"error": "用户名或密码错误"}, 401)
        if not u["is_active"]:
            return self._json({"error": "账号已被禁用"}, 403)

        token = A.create_session(u["id"], self.headers.get("User-Agent", ""),
                                 self._client_ip())
        A.touch_login(u["id"])
        return self._json(
            {"ok": True, "user": {"username": u["username"], "role": u["role"]},
             "quota": A.quota_status(u["id"], u["role"] == "admin")},
            200, self._set_session_cookie(token))

    def _auth_register(self):
        # 默认关闭注册；开放时也不允许自助创建管理员
        if not A.ALLOW_REGISTER:
            return self._json({"error": "当前未开放注册，请联系管理员开通账号"}, 403)
        data = self._read_json()
        username = (data.get("username") or "").strip()
        password = data.get("password") or ""
        if len(password) < 8:
            return self._json({"error": "密码至少 8 位"}, 400)
        try:
            A.create_user(username, password, role="user")
        except ValueError as e:
            return self._json({"error": str(e)}, 409)
        return self._json({"ok": True, "message": "注册成功，请登录"}, 201)

    def _auth_logout(self):
        A.drop_session(self._cookie_token())
        return self._json({"ok": True}, 200, self._clear_session_cookie())

    # ── GET ───────────────────────────────────────────────────────
    def do_GET(self):
        u = urlparse(self.path)
        p, q = u.path, parse_qs(u.query)

        # 认证接口（无需登录）。未登录时也回 allow_register，供登录卡提示
        if p == "/api/auth/me":
            me = self._current_user()
            if me is None:
                return self._json({"error": "未登录", "code": "UNAUTHORIZED",
                                   "allow_register": A.ALLOW_REGISTER}, 401)
            return self._json({
                "username": me["username"], "role": me["role"],
                "quota": A.quota_status(me["id"], me["role"] == "admin"),
                "allow_register": A.ALLOW_REGISTER,
            })

        # 页面与静态资源：公开。
        # ⚠️ index.html 只是个空壳，所有数据都在受保护的 /api/* 后面；
        #    而登录卡本身要用 style.css / app.js —— 绝不能把静态资源也拦住，
        #    否则登录页会掉样式（无 CSS 变量 → 配色全丢）。
        #    登录闸门在页面内完成，未登录访问 / 不再跳转。
        if p in ("/", "/index.html", "/login", "/login.html"):
            return self._serve_static("index.html")
        if p.startswith("/static/"):
            return self._serve_static(p[len("/static/"):])
        if p == "/favicon.ico":
            return self._serve_static("favicon.ico")

        # ── 以下全部需要登录 ──
        me = self._current_user()
        if me is None:
            return self._json({"error": "未登录", "code": "UNAUTHORIZED"}, 401)

        owner = me["username"]
        is_admin = me["role"] == "admin"

        if p == "/api/config":
            return self._json({
                "engine": runner.find_engine().name,
                "mock_default": os.environ.get("DGTF_APP_MOCK") == "1",
                "creds": runner.credential_status(),
                "outputs": oi.stats(owner, is_admin),
                "max_concurrent": runner.MAX_CONCURRENT,
                "user": {"username": owner, "role": me["role"]},
                "quota": A.quota_status(me["id"], is_admin),
            })

        if p == "/api/params":
            return self._json(prm.load_params())

        if p == "/api/tasks":
            return self._json({"tasks": runner.list_tasks(owner, is_admin)})

        m = re.match(r"^/api/tasks/([^/]+)/log$", p)
        if m:
            off = int((q.get("offset") or ["0"])[0] or 0)
            mode = (q.get("mode") or ["filtered"])[0]
            if mode not in ("raw", "filtered"):
                mode = "filtered"
            r = runner.read_log(m.group(1), off, mode, owner=owner, is_admin=is_admin)
            return self._json(r) if r is not None else self._json({"error": "not found"}, 404)

        m = re.match(r"^/api/tasks/([^/]+)/layers$", p)
        if m:
            r = runner.read_layers(m.group(1), owner, is_admin)
            return self._json(r) if r is not None else self._json({"error": "not found"}, 404)

        m = re.match(r"^/api/tasks/([^/]+)/result$", p)
        if m:
            t = runner.get_task(m.group(1), owner, is_admin)
            if not t or not t.get("output_name"):
                return self._json({"error": "尚无产物"}, 404)
            return self._json({"name": t["output_name"],
                               "body": oi.read_body(t["output_name"], owner=owner,
                                                    is_admin=is_admin)})

        m = re.match(r"^/api/tasks/([^/]+)$", p)
        if m:
            t = runner.get_task(m.group(1), owner, is_admin)
            return self._json(t) if t else self._json({"error": "not found"}, 404)

        if p == "/api/outputs":
            if (q.get("facets") or [""])[0] == "1":
                return self._json(oi.facets(owner, is_admin))
            body = (q.get("body") or ["0"])[0] == "1"
            filters: dict = {}
            for k in _FACETS:
                v = (q.get(k) or [""])[0]
                if v:
                    filters[k] = v
            days = (q.get("days") or [""])[0]
            if days:
                filters["days"] = days
            if (q.get("packed") or [""])[0] == "1":
                filters["has_packed"] = True
            recs = oi.search((q.get("q") or [""])[0], with_body=body,
                             filters=filters, owner=owner, is_admin=is_admin)
            return self._json({"count": len(recs), "items": recs})

        if p == "/api/outputs/facets":
            return self._json(oi.facets(owner, is_admin))

        m = re.match(r"^/api/archive/(.+)$", p)
        if m:
            name = unquote(m.group(1))
            body = runner.read_archive(name, owner, is_admin)
            if body is None:
                return self._json({"error": "not found"}, 404)
            return self._json({"name": Path(name).name, "body": body})

        # 本地资料库（导入的资料 → 外部证据锚点）/ 联网检索库
        if p == "/api/library/local":
            try:
                _obj = json.loads(lib.ANCHOR_FILE.read_text(
                    encoding="utf-8", errors="replace"))
                _n = lib._anchor_items(_obj)
            except (OSError, ValueError):
                _n = 0
            return self._json({
                "items": lib.imported_files(),
                "candidates": lib.local_anchors(),
                "anchor_file": str(lib.ANCHOR_FILE.relative_to(
                    lib.PROJECT_ROOT)).replace("\\", "/"),
                "anchor_items": _n,
            })
        if p == "/api/library/web":
            return self._json({"items": lib.web_results(owner=owner, is_admin=is_admin),
                               "hits": lib.web_hits()})
        m = re.match(r"^/api/library/local/(.+)$", p)
        if m:
            body = lib.read_local(unquote(m.group(1)))
            if body is None:
                return self._json({"error": "not found"}, 404)
            return self._json({"name": Path(m.group(1)).name, "body": body})

        m = re.match(r"^/api/outputs/(.+)$", p)
        if m:
            name = unquote(m.group(1))
            body = oi.read_body(name, owner=owner, is_admin=is_admin)
            if not body:
                return self._json({"error": "not found"}, 404)
            return self._json({"name": Path(name).name, "body": body})

        return self._json({"error": "not found"}, 404)

    # ── POST ──────────────────────────────────────────────────────
    def do_POST(self):
        u = urlparse(self.path)
        p = u.path

        # 认证接口（无需登录）
        if p == "/api/auth/login":
            return self._auth_login()
        if p == "/api/auth/register":
            return self._auth_register()
        if p == "/api/auth/logout":
            return self._auth_logout()

        # ── 以下全部需要登录 ──
        me = self._current_user()
        if me is None:
            return self._json({"error": "未登录", "code": "UNAUTHORIZED"}, 401)
        owner = me["username"]
        is_admin = me["role"] == "admin"

        # 本地资料库：导入 / 删除
        if p == "/api/library/import":
            data = self._read_json()
            files = data.get("files")
            if not isinstance(files, list) or not files:
                return self._json({"error": "files 不能为空"}, 400)
            return self._json(lib.import_files(files))

        if p == "/api/library/delete":
            data = self._read_json()
            ok = lib.delete_imported(str(data.get("name") or ""))
            return self._json({"ok": ok}, 200 if ok else 404)

        m = re.match(r"^/api/tasks/([^/]+)/cancel$", p)
        if m:
            ok = runner.cancel_task(m.group(1), owner, is_admin)
            return self._json({"ok": ok}, 200 if ok else 409)

        if p == "/api/tasks":
            data = self._read_json()
            question = (data.get("question") or "").strip()
            if not question:
                return self._json({"error": "问题不能为空"}, 400)

            # ⚠️ 每日配额校验（管理员豁免）
            allowed, reason = A.check_quota(me["id"], is_admin)
            if not allowed:
                return self._json({"error": reason, "code": "QUOTA_EXCEEDED"}, 429)

            opts = data.get("opts") or {}
            if not isinstance(opts, dict):
                opts = {}
            try:
                tid = runner.start_task(question, opts, owner=owner)
            except ValueError as e:
                return self._json({"error": str(e)}, 400)
            A.log_task(me["id"], tid)       # 记账，供配额统计
            return self._json({"id": tid,
                               "quota": A.quota_status(me["id"], is_admin)}, 201)

        return self._json({"error": "not found"}, 404)


def main() -> int:
    ap = argparse.ArgumentParser(description="元DGTF 本地 Web 应用")
    ap.add_argument("--host", default="127.0.0.1")
    ap.add_argument("--port", type=int, default=8765)
    ap.add_argument("--verbose", action="store_true")
    args = ap.parse_args()

    # 启动即确保用户库存在与管理员就绪
    A.init_db()
    pwd, created = A.ensure_admin()

    srv = ThreadingHTTPServer((args.host, args.port), Handler)
    srv.verbose = args.verbose
    srv.daemon_threads = True
    mock = "开" if os.environ.get("DGTF_APP_MOCK") == "1" else "关"
    print(f"元DGTF 应用已启动： http://{args.host}:{args.port}")
    print(f"  引擎：{runner.find_engine().name}")
    print(f"  mock：{mock}    并发上限：{runner.MAX_CONCURRENT}")
    print(f"  每日任务上限：{A.DAILY_TASK_LIMIT}   开放注册：{'是' if A.ALLOW_REGISTER else '否'}")
    if created:
        print(f"  ✅ 已创建管理员 {A.DEFAULT_ADMIN}，初始密码：{pwd}")
        print("     ⚠️ 请登录后立即改密（python dgtf_app/auth.py passwd）")
    if args.host not in ("127.0.0.1", "localhost"):
        print("  ⚠️ 已监听非本机地址：请确保已配置 HTTPS，否则密码将明文传输！")
    print("  Ctrl+C 停止")
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        print("\n已停止")
    finally:
        srv.server_close()
    return 0


if __name__ == "__main__":
    sys.exit(main())
