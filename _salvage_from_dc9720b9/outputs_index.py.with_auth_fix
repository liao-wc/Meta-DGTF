# -*- coding: utf-8 -*-
"""元DGTF 应用层 · 产物索引与检索（只读）。

扫描产物（引擎的真跑产物），把头部那一段元数据
（`**时间**` / `**调度**` / `**停止**` / `**可判定性**` / `**取向**` / …）
解析成结构化记录，供前端做列表、筛选与关键词检索。

⚠️ 多用户隔离后的目录约定：
  outputs/<用户名>/*.md   —— 各用户自己的产物（互不可见）
  outputs/*.md            —— 改造前的历史产物，统一归属管理员（不搬动原文件）

只读：本模块不写任何产物、不碰引擎主文件。
"""

from __future__ import annotations

import json
import re
import time
from pathlib import Path

APP_DIR = Path(__file__).resolve().parent
PROJECT_ROOT = APP_DIR.parent
OUTPUTS_DIR = PROJECT_ROOT / "outputs"

# 历史产物（平铺在根）的归属者，与 engine_runner.LEGACY_OWNER 保持一致
LEGACY_OWNER = "admin.aL"
_SAFE_NAME_RE = re.compile(r"[^0-9A-Za-z_.\-]+")


def safe_owner(owner: str | None) -> str:
    name = _SAFE_NAME_RE.sub("_", (owner or "").strip())
    return name or LEGACY_OWNER


def owner_dir(owner: str) -> Path:
    return OUTPUTS_DIR / safe_owner(owner)

# 头部元数据都挤在文件开头，只读前若干字节即可
_HEADER_SCAN_BYTES = 16000

# `**键**：值`  —— 半角/全角冒号都要认（v1.23.14 踩过：只写全角命中 0 条）
_KV_RE = re.compile(r"^\*\*(?P<k>[^*]+?)\*\*\s*[:：]\s*(?P<v>.*)$")
_TITLE_RE = re.compile(r"^#\s*(?:元\s*)?DGTF\s*[·:：]\s*(?P<t>.+?)\s*$")
_FNAME_RE = re.compile(r"^(?P<ts>\d{8}_\d{6})_(?P<q>.+)\.md$")

# 缓存：按 owner 分别缓存（文件集合 + 各自 mtime 不变就复用）
_CACHE: dict[str, dict] = {}


def _scan_dirs(owner: str | None, is_admin: bool = False) -> list[Path]:
    """该用户可见的产物目录列表。

    - 普通用户：只有 outputs/<自己>/
    - 管理员：outputs/<自己>/ + outputs/ 根（历史产物归属管理员）
    """
    if owner is None:
        return []
    dirs = [owner_dir(owner)]
    if is_admin:
        dirs.append(OUTPUTS_DIR)
    return [d for d in dirs if d.is_dir()]


def _dir_signature(owner: str, is_admin: bool) -> tuple:
    sig = []
    for d in _scan_dirs(owner, is_admin):
        tag = d.name if d != OUTPUTS_DIR else "__root__"
        try:
            for p in sorted(d.glob("*.md")):
                # 排除分层产物（<stamp>.<层名>.md），列表里只显示主产物
                if _is_layer_md(p.name):
                    continue
                try:
                    sig.append((tag, p.name, p.stat().st_mtime))
                except OSError:
                    pass
        except OSError:
            pass
    return tuple(sig)


# 分层产物文件名形如 `<stamp>.<层名>.md`，层名是固定四个中文词
_LAYER_SUFFIX = ("唯识", "中观", "因明", "止观")


def _is_layer_md(name: str) -> bool:
    """判断是否为分层产物（应从主产物列表里排除）。"""
    return any(name.endswith(f".{n}.md") for n in _LAYER_SUFFIX)


def scan(owner: str | None = None, is_admin: bool = False,
         force: bool = False) -> list[dict]:
    """返回该用户可见的产物记录，按时间倒序。带缓存的只读扫描。"""
    key = safe_owner(owner) + ("|admin" if is_admin else "")
    sig = _dir_signature(safe_owner(owner), is_admin)
    cached = _CACHE.get(key)
    if not force and cached and cached["key"] == sig:
        return cached["records"]

    records = []
    for d in _scan_dirs(owner, is_admin):
        for p in d.glob("*.md"):
            if _is_layer_md(p.name):
                continue          # 分层产物不进主列表
            try:
                rec = _parse_one(p)
            except OSError:
                continue
            # 标注来源目录，便于 read_body 定位
            rec["_dir"] = str(d)
            records.append(rec)
    # 同名产物去重（用户目录优先，避免与根目录历史产物重名时冲突）
    seen: set[str] = set()
    uniq: list[dict] = []
    for r in sorted(records, key=lambda x: (x["_dir"] == str(OUTPUTS_DIR), x["mtime"])):
        if r["name"] in seen:
            continue
        seen.add(r["name"])
        uniq.append(r)
    uniq.sort(key=lambda r: r["mtime"], reverse=True)
    _CACHE[key] = {"key": sig, "records": uniq}
    return uniq


def read_body(name: str, limit: int | None = None,
              owner: str | None = None, is_admin: bool = False) -> str:
    """读取某份产物正文（整篇；limit 为字符上限）。

    ⚠️ 权限：只在调用者可见的目录里找，且只取文件名（挡目录穿越）。
    """
    n = Path(name).name
    for d in _scan_dirs(owner, is_admin):
        p = d / n
        if p.is_file():
            try:
                with open(p, "r", encoding="utf-8", errors="replace") as f:
                    return f.read(limit) if limit else f.read()
            except OSError:
                return ""
    return ""

# 前端筛选用到的维度 → 头部元数据键
FACET_KEYS = {
    "decidability": "可判定性",
    "orientation": "取向",
    "parallel": "并行模式",
    "stop": "停止",
}


def _read_head(path: Path, n: int = _HEADER_SCAN_BYTES) -> str:
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as f:
            return f.read(n)
    except OSError:
        return ""


def _parse_header(text: str) -> tuple[str, dict]:
    """从头部文本里取标题与元数据键值对。"""
    lines = text.splitlines()
    title = ""
    if lines:
        m = _TITLE_RE.match(lines[0].strip())
        if m:
            title = m.group("t").strip()

    meta: dict[str, str] = {}
    pending_key: str | None = None
    for raw in lines[1:]:
        s = raw.strip()
        if not s:
            continue
        m = _KV_RE.match(s)
        if m:
            k, v = m.group("k").strip(), m.group("v").strip()
            if k not in meta:
                meta[k] = v
                pending_key = k if not v else None
            continue
        # 缩进子项 → 并入上一个键的值（如「**分层目标**：」下面的层明细）
        if raw[:1] in (" ", "\t") and pending_key:
            meta[pending_key] = (meta[pending_key] + " " + s).strip()
            continue
        if s[:1] in ("-", "*", "•"):  # 头部里的项目符号行（可判定清单等）
            continue
        # 既不是 KV、也不是列表/缩进 → 正文开始了
        break
    return title, meta


def _parse_one(path: Path) -> dict:
    st = path.stat()
    head = _read_head(path)
    title, meta = _parse_header(head)

    fname_q = ""
    m = _FNAME_RE.match(path.name)
    if m:
        fname_q = m.group("q").replace("_", " ").strip()

    question = title or fname_q or path.stem
    ts = meta.get("时间", "")
    packed = path.with_suffix(".packed.json")
    return {
        "name": path.name,
        "title": title or question,
        "question": question,
        "time": ts,
        "mtime": st.st_mtime,
        "size": st.st_size,
        "has_packed": packed.exists(),
        "meta": meta,
    }


def _snippet(text: str, q: str, width: int = 180) -> str:
    low, ql = text.lower(), q.lower()
    i = low.find(ql)
    if i < 0:
        return ""
    a = max(0, i - width // 2)
    b = min(len(text), i + len(q) + width // 2)
    s = text[a:b].replace("\n", " ").strip()
    return ("…" if a else "") + s + ("…" if b < len(text) else "")


def _pass_filters(rec: dict, filters: dict) -> bool:
    if not filters:
        return True
    days = filters.get("days")
    if days:
        try:
            if time.time() - rec["mtime"] > float(days) * 86400:
                return False
        except (TypeError, ValueError):
            pass
    for fkey, mkey in FACET_KEYS.items():
        want = filters.get(fkey)
        if want:
            have = rec["meta"].get(mkey, "")
            if want.lower() not in have.lower():
                return False
    if filters.get("has_packed") and not rec["has_packed"]:
        return False
    return True


def search(query: str = "", *, with_body: bool = False,
           filters: dict | None = None, limit: int = 300,
           owner: str | None = None, is_admin: bool = False) -> list[dict]:
    """关键词检索（默认搜标题 + 头部元数据；with_body=True 时再搜正文）。

    ⚠️ 只在该用户可见的目录内检索。
    """
    q = (query or "").strip()
    out: list[dict] = []
    for rec in scan(owner, is_admin):
        if not _pass_filters(rec, filters or {}):
            continue
        if not q:
            r = dict(rec)
            r.pop("_dir", None)          # 内部字段不外泄
            out.append(r)
            continue
        head_hay = rec["title"] + "\n" + json.dumps(rec["meta"], ensure_ascii=False)
        if q.lower() in head_hay.lower():
            r = dict(rec)
            r.pop("_dir", None)
            r["snippet"] = _snippet(head_hay, q)
            r["matched_in"] = "head"
            out.append(r)
            continue
        if with_body:
            body = read_body(rec["name"], owner=owner, is_admin=is_admin)
            if q.lower() in body.lower():
                r = dict(rec)
                r.pop("_dir", None)
                r["snippet"] = _snippet(body, q)
                r["matched_in"] = "body"
                out.append(r)
        if len(out) >= limit:
            break
    return out[:limit]


def facets(owner: str | None = None, is_admin: bool = False) -> dict:
    """给前端下拉框用的可选值集合（按该用户可见范围统计）。"""
    from collections import Counter
    counters = {k: Counter() for k in FACET_KEYS}
    for rec in scan(owner, is_admin):
        for fkey, mkey in FACET_KEYS.items():
            v = rec["meta"].get(mkey, "")
            if v:
                counters[fkey][v] += 1
    return {k: [{"value": v, "count": n} for v, n in c.most_common()]
            for k, c in counters.items()}


def stats(owner: str | None = None, is_admin: bool = False) -> dict:
    recs = scan(owner, is_admin)
    total_bytes = sum(r["size"] for r in recs)
    return {
        "count": len(recs),
        "total_mb": round(total_bytes / 1024 / 1024, 1),
        "packed": sum(1 for r in recs if r["has_packed"]),
        "latest": recs[0]["title"] if recs else "",
        "latest_time": recs[0]["time"] if recs else "",
    }


if __name__ == "__main__":
    import sys
    _owner = sys.argv[1] if len(sys.argv) > 1 else LEGACY_OWNER
    if len(sys.argv) > 2 and sys.argv[2] == "search":
        for r in search(" ".join(sys.argv[3:]) or "", owner=_owner):
            print(f"- {r['time']}  {r['title']}")
    else:
        print(json.dumps(stats(owner=_owner), ensure_ascii=False, indent=2))
